#!/usr/bin/bash

src=""
dst=""
flags=()
key=keys/transmission

while [ $# -gt 0 ]; do
	case "$1" in
		-h|-help|--help|help)
			echo "Usage ./scp [-h|--help] <source> <dest> [scp flags]"
			exit 0
			;;
		-i)
			key="$2"
			shift 2
			;;
		-*)
			flags+=("$1")
			shift
			;;
		*)
			if [ -z "${src}" ]; then
				src="$1"
			elif [ -z "${dst}" ]; then
				dst="$1"
			fi
			shift
			;;
	esac
done

echo scp -i "${key}" "${flags[@]}" "ubuntu@$(tofu output -raw ip):$src" "$dst"
scp -i "${key}" "${flags[@]}" "ubuntu@$(tofu output -raw ip):$src" "$dst"
